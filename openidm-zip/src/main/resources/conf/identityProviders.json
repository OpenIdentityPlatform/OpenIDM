      "client_id" : "",
      "client_secret" : "",
      "scope" : [
        "public_profile",
        "email"
      ],
      "authenticationId" : "id",
      "propertyMap" : [
        {
          "source" : "id",
          "target" : "id"
        },
        {
          "source" : "name",
